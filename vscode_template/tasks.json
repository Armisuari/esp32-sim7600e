{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build project",
            "type": "shell",
            "command": "idf.py",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "fileLocation": ["relative", "${workspaceRoot}"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "ESP-IDF: Clean project",
            "type": "shell",
            "command": "idf.py",
            "args": ["fullclean"],
            "group": "build"
        },
        {
            "label": "ESP-IDF: Flash project",
            "type": "shell",
            "command": "idf.py",
            "args": ["flash"],
            "group": "build",
            "dependsOn": "ESP-IDF: Build project"
        },
        {
            "label": "ESP-IDF: Monitor",
            "type": "shell",
            "command": "idf.py",
            "args": ["monitor"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        },
        {
            "label": "ESP-IDF: Flash and Monitor",
            "type": "shell",
            "command": "idf.py",
            "args": ["flash", "monitor"],
            "group": "build",
            "dependsOn": "ESP-IDF: Build project",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        }
    ]
}